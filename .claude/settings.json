{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(wc -l*)",
      "Bash(python .claude/scripts/ai-log.py*)",
      "Bash(python3 .claude/scripts/ai-log.py*)",
      "Bash(python .claude/scripts/template-update.py --check*)",
      "Bash(python3 .claude/scripts/template-update.py --check*)",
      "Bash(python .claude/scripts/template-update.py --status*)",
      "Bash(python3 .claude/scripts/template-update.py --status*)",
      "Bash(python .claude/scripts/template-update.py --init*)",
      "Bash(python3 .claude/scripts/template-update.py --init*)",
      "Bash(python .claude/scripts/template-update.py --set*)",
      "Bash(python3 .claude/scripts/template-update.py --set*)",
      "Bash(python .claude/scripts/template-update.py --graft)",
      "Bash(python3 .claude/scripts/template-update.py --graft)",
      "Bash(python .claude/scripts/template-update.py --apply)",
      "Bash(python3 .claude/scripts/template-update.py --apply)",
      "Bash(python .claude/scripts/template-update.py --continue)",
      "Bash(python3 .claude/scripts/template-update.py --continue)",
      "Bash(python .claude/scripts/template-update.py --abort)",
      "Bash(python3 .claude/scripts/template-update.py --abort)",
      "Bash(python .claude/scripts/new-project.py*)",
      "Bash(python3 .claude/scripts/new-project.py*)",
      "Bash(python .claude/scripts/maintenance-check.py*)",
      "Bash(python3 .claude/scripts/maintenance-check.py*)",
      "Bash(git fetch template*)",
      "Bash(git merge --abort)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/template-update.py\" --check --quiet; else python \"$CLAUDE_PROJECT_DIR/.claude/scripts/template-update.py\" --check --quiet; fi || true",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/maintenance-check.py\" --check --quiet; else python \"$CLAUDE_PROJECT_DIR/.claude/scripts/maintenance-check.py\" --check --quiet; fi || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?!Agent$)",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ai-log.py\" --hook",
            "async": true
          }
        ]
      }
    ]
  }
}
