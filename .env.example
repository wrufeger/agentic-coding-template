# Beispiel-Umgebungsdatei fuer {{PROJEKTNAME}}.
# Kopieren nach ".env" und Werte anpassen:
#   cp .env.example .env
#
# .env wird nie committet (siehe .gitignore). Namen hier dokumentieren, Werte nur lokal/im Secret-Store
# der Zielumgebung (siehe docs/project/security.md).

# --- Anwendung (Platzhalter - beim Zuschneiden des Templates durch echte Variablen ersetzen) ---
# APP_ENV=development
# APP_SECRET=bitte-aendern

# --- Datenbank (Platzhalter, falls zutreffend) ---
# DB_HOST=localhost
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=bitte-aendern
