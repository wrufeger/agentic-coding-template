    //   python -c "import secrets; print(secrets.token_urlsafe(48))"
    'AGENTIC_FEEDBACK_JWT_SECRET' => 'HIER-EIN-LANGES-ZUFALLSGEHEIMNIS-EINSETZEN',

    // Nur aendern, wenn feedback-abholen.py entsprechend angepasst wird.
    'AGENTIC_FEEDBACK_JWT_ISS' => 'templatedev',
